# ─────────────────────────────────────────────────────────────
# CogniStudy – Environment Variable Template
# Copy to .env and fill in your own values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# Django core
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-strong-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames for production
# Example: myapp.railway.app,www.myapp.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database (MySQL) ───────────────────────────────────────
DB_NAME=cognistudy_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Google Gemini AI ───────────────────────────────────────
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
